# Supabase — client-safe (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server only (NEVER expose to the browser). Used for the public
# booking endpoint and admin operations that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the app, used to build QR codes and links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
